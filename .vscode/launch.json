    "version": "0.2.0",
    "configurations": [
        {
            "type": "firefox",
            "request": "launch",
            "name": "Ejecutar en navegador",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "npm: start",
            "postDebugTask": "terminar vite",
        },
        {
            "type": "firefox",
            "request": "attach",
            "name": "Ejecutar en Electron",
            "port": 9222,
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "npm: electron",
            "postDebugTask": "terminar electron"
        }
    ]
}